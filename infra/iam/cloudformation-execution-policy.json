{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid":"AllowBucketCreation",
      "Effect":"Allow",
      "Action":"s3:CreateBucket",
      "Resource": "*"
    },
    {
      "Sid": "AllowBucketSecurityConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketPublicAccessBlock",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketPolicy"
      ],
      "Resource":"*"
    }
  ]
}